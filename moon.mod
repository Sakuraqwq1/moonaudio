// moonaudio — pure MoonBit audio decoding and DSP toolkit.
// Documentation: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "Sakuraqwq1/moonaudio"

version = "0.3.1"

readme = "README.md"

repository = "https://github.com/Sakuraqwq1/moonaudio"

license = "Apache-2.0"

keywords = [
  "audio",
  "dsp",
  "wav",
  "flac",
  "aiff",
  "au",
  "resampler",
  "fft",
  "spectrogram",
  "decoder",
]

preferred_target = "wasm"

description = "Pure MoonBit audio toolkit: WAV/AIFF/AU/FLAC decoding, PCM conversion, resampling, FFT and spectrograms, with zero platform bindings."
